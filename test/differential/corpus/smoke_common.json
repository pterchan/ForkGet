    "id": "transaction_commit_persists",
    "tags": ["smoke"],
    "engines": ["mysql", "postgresql"],
    "fixture": "orders_basic",
    "steps": [
      { "sql": "BEGIN", "expect": { "kind": "affected", "count": 0 } },
      {
        "sql": "UPDATE orders SET amount = 11.00 WHERE tenant_id = 1 AND id = 1",
        "expect": { "kind": "affected", "count": 1 }
      },
      { "sql": "COMMIT", "expect": { "kind": "affected", "count": 0 } },
      {
        "sql": "SELECT tenant_id, id, amount FROM orders WHERE tenant_id = 1 AND id = 1 ORDER BY tenant_id, id",
        "expect": { "kind": "rows", "order": "total" }
      }
    ]
